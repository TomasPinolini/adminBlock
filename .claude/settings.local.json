{
  "permissions": {
    "allow": [
      "Bash(npx create-next-app@latest:*)",
      "Bash(robocopy:*)",
      "Bash(powershell -Command:*)",
      "Bash(dir:*)",
      "Bash(npm install:*)",
      "Bash(npm run build:*)",
      "Bash(npm run db:push:*)",
      "Bash(git add:*)",
      "Bash(git push:*)",
      "Bash(npx vercel:*)",
      "WebFetch(domain:blockimpresos.com)",
      "Bash(npx drizzle-kit generate:*)",
      "Bash(npx drizzle-kit push)",
      "Bash(npx drizzle-kit migrate:*)",
      "Bash(node:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(npx tsc:*)",
      "Bash(npx -p typescript tsc:*)",
      "Bash(git mv:*)",
      "WebFetch(domain:skills.sh)",
      "Bash(head:*)",
      "WebFetch(domain:github.com)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "WebSearch",
      "Bash(npx skills add:*)",
      "Bash(npx skills:*)",
      "Bash(npm ls:*)",
      "Bash(git commit:*)",
      "WebFetch(domain:developers.mailersend.com)",
      "WebFetch(domain:www.mercadopago.com.ar)",
      "Bash(npx next build:*)",
      "WebFetch(domain:navenegocios.ar)",
      "WebFetch(domain:centralweb.info)",
      "Bash(npx supabase:*)",
      "Bash(psql:*)",
      "Bash(npx next dev:*)",
      "Bash(curl:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "WebFetch(domain:supabase.com)",
      "Bash(claude mcp remove:*)",
      "Bash(claude mcp add:*)",
      "Bash(claude mcp list:*)",
      "Bash(claude mcp login:*)",
      "Bash(git status:*)",
      "Bash(gh api:*)",
      "Bash(where:*)",
      "WebFetch(domain:admin-block-nine.vercel.app)",
      "WebFetch(domain:admin-block.vercel.app)",
      "WebFetch(domain:adminblock.vercel.app)",
      "WebFetch(domain:admin-block-six.vercel.app)",
      "Bash(git stash pop:*)",
      "Bash(git stash:*)",
      "Bash(python:*)",
      "mcp__supabase__list_tables",
      "mcp__supabase__execute_sql",
      "mcp__supabase__apply_migration",
      "Bash(npx kill-port:*)",
      "Bash(git reset:*)",
      "mcp__supabase__list_migrations",
      "Bash(npx playwright install:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "supabase"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/db-push-guard.js",
            "statusMessage": "Checking DB operation safety..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/schema-sentinel.js",
            "statusMessage": "Checking for schema changes..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/eslint-fix.js",
            "timeout": 30,
            "statusMessage": "Running ESLint auto-fix..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/tsc-check.js",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/build-check.js",
            "timeout": 120,
            "statusMessage": "Validating build..."
          }
        ]
      }
    ]
  }
}
